      "name": "1. Health & PostGIS Diagnostics",
      "item": [
        {
          "name": "GET /api/health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.toHaveStatus(200); });",
                  "pm.test('PostgreSQL + PostGIS is connected', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('ONLINE');",
                  "    pm.expect(json.database_engine).to.eql('PostgreSQL + PostGIS');",
                  "    pm.expect(json.public_table_count).to.be.at.least(22);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
