# ==============================================================================
# AeroCadastre GeoAI Enterprise Platform — Environment Configuration Template
# ==============================================================================
# NOTE: Do NOT commit production credentials or actual secret keys to git.
# In Render deployment, configure these as Render Service Environment Variables.

# --- Environment & Server ---
ENVIRONMENT=production
PORT=8000
CORS_ORIGINS=*

# --- Database & PostGIS ---
# Render PostgreSQL with PostGIS extension:
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Render Internal Database URL can be pasted here (driver prefix will be normalized automatically).
DATABASE_URL=postgresql+psycopg2://postgres:<password>@127.0.0.1:5432/aerocadastre

# --- Security & JWT Authentication ---
# Generate with: openssl rand -hex 32
SECRET_KEY=<replace-with-secure-64-byte-hex-token>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REQUIRE_AUTH_FOR_MUTATIONS=false

# --- Spatial Reference Systems (CRS) ---
DEFAULT_GEOGRAPHIC_CRS=EPSG:4326
DEFAULT_PROJECTED_CRS=EPSG:32643
DEFAULT_SRID=4326
METRIC_SRID=32643

# --- Storage Root Paths (Optional overrides) ---
# PROJECT_ROOT=/app
