# AeroCadastre GeoAI Backend Configuration Template
# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/aerocadastre

# Authentication & Security
# Generate secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_SECURE_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REQUIRE_AUTH_FOR_MUTATIONS=false

# Environment Setting
ENVIRONMENT=development

# Spatial Coordinate Systems
DEFAULT_GEOGRAPHIC_CRS=EPSG:4326
DEFAULT_PROJECTED_CRS=EPSG:32643
DEFAULT_SRID=4326
METRIC_SRID=32643

# Storage Paths (Optional - defaults to repository root subdirectories)
# PROJECT_ROOT=D:/SIH26012_AeroCadastre
# DATA_DIR=D:/SIH26012_AeroCadastre/data
# MODELS_DIR=D:/SIH26012_AeroCadastre/models
# EXPERIMENTS_DIR=D:/SIH26012_AeroCadastre/experiments
